<div data-recording-studio-moveable-modal-root="true"
     data-recording-studio-moveable-updating="<%= moveable_t("js.updating") %>"
     data-recording-studio-moveable-moving="<%= moveable_t("js.moving") %>"
     data-recording-studio-moveable-load-error="<%= moveable_t("js.load_error") %>">
  <%= render FlatPack::Modal::Component.new(
    id: "recording-studio-moveable-modal",
    size: :lg,
    body_height_mode: :fixed,
    body_height: "70vh",
    data: { recording_studio_moveable_modal_element: true }
  ) do |modal| %>
    <% modal.body do %>
      <div data-recording-studio-moveable-modal-body="true">
        <%= render "move_ui", title: moveable_title_for(@recording) %>
      </div>
    <% end %>
  <% end %>
</div>