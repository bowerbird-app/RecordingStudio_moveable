<div class="space-y-4">
  <% recording_studio_page_nav(
    page_nav_anchor_url: move_back_path,
    page_nav_anchor_label: "Return to previous page"
  ) %>
  <% default_layout_head { recording_studio_moveable_meta_tags } if respond_to?(:default_layout_head) %>

  <%= render FlatPack::PageTitle::Component.new(
    title: "Change #{moveable_root_label}",
    class: "pb-0 mb-0"
  ) %>
</div>

<div class="mt-4 max-w-3xl">
  <%= render FlatPack::Picker::Component.new(
    id: "move-workspace-picker-#{@recording.id}",
    items: moveable_workspace_picker_items_for(@workspace_roots),
    title: "",
    class: "!border-0 !bg-transparent !shadow-none !rounded-none !p-0 sm:!p-0",
    selection_mode: :single,
    auto_confirm: true,
    accepted_kinds: ["workspace"],
    searchable: true,
    search_placeholder: "Search #{moveable_root_label(count: 2)}",
    search_mode: :local,
    results_layout: :list,
    output_mode: :field,
    modal: false,
    empty_state_text: "No other #{moveable_root_label(count: 2)} are available for this move.",
    form: {
      url: move_recording_path_for(
        recording_id: @recording.id,
        redirect_to: @redirect_to,
        redirect_mode: @redirect_mode,
        q: nil
      ),
      method: :get,
      field: "target_root_id",
      value_mode: :id
    }
  ) %>
</div>