<% if @display == :full_page %>
  <% content_for :title, title %>
  <% content_for :subtitle, moveable_t("dialog.subtitle") %>
  <% flat_pack_page_nav(
       round: true,
       style: :default,
       back_href: move_back_path,
       back_tooltip: moveable_t("dialog.back")
     ) %>
  <% default_layout_head { recording_studio_moveable_meta_tags } if respond_to?(:default_layout_head) %>
<% else %>
  <div class="space-y-4">
    <%= render FlatPack::PageTitle::Component.new(
      title: title,
      subtitle: moveable_t("dialog.subtitle"),
      class: "pb-0 mb-0"
    ) %>
  </div>
<% end %>

<div class="mt-4 max-w-3xl">
  <% if @workspace_selection_path.present? %>
    <div class="mb-4 flex flex-wrap items-center gap-2 text-sm text-(--surface-muted-content-color)">
      <strong><%= moveable_label_for(@target_root || @current_root) %></strong>
      <%= render FlatPack::Button::Component.new(
        text: moveable_t("dialog.change"),
        href: @workspace_selection_path,
        style: :ghost,
        size: :sm
      ) %>
    </div>
  <% end %>

  <%= render FlatPack::Picker::Component.new(
    id: "move-destination-picker-#{@recording.id}",
    items: moveable_picker_items_for(@destinations),
    title: "",
    class: "!border-0 !bg-transparent !shadow-none !rounded-none !p-0 sm:!p-0",
    selection_mode: :single,
    auto_confirm: true,
    accepted_kinds: ["record"],
    searchable: true,
    search_placeholder: moveable_t("dialog.search_destinations"),
    search_mode: :local,
    results_layout: :list,
    output_mode: :field,
    modal: false,
    empty_text: moveable_t("dialog.empty_destinations"),
    form: {
      url: move_recording_path_for(
        recording_id: @recording.id,
        display: @display == :modal ? "modal" : "full_page",
        target_root_id: @target_root&.id,
        redirect_to: @redirect_to,
        redirect_mode: @redirect_mode,
        q: @query.presence
      ),
      method: :post,
      field: "destination_id",
      value_mode: :id
    }
  ) %>
</div>
