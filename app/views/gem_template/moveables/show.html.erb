<% title = "#{moveable_title_for(@recording)} to..." %>

<div class="space-y-4">
  <% if @display == :full_page %>
    <%= render FlatPack::Breadcrumb::Component.new(
      items: [{ text: "Back", href: move_back_path, icon: "chevron-left" }],
      class: "mb-3"
    ) %>
  <% end %>

  <%= render FlatPack::PageTitle::Component.new(
    title: title,
    class: "pb-0 mb-0"
  ) %>
</div>

<div class="mt-4 max-w-3xl">
  <div class="space-y-4">
    <%= form_with url: move_recording_path_for(recording_id: @recording.id), method: :get, local: true do |form| %>
      <%= hidden_field_tag :display, @display == :modal ? "modal" : "full_page" %>
      <%= hidden_field_tag :redirect_to, @redirect_to %>

      <%= render FlatPack::SearchInput::Component.new(
        name: :q,
        value: @query,
        placeholder: "Search destinations"
      ) %>
    <% end %>

    <% if @destinations.empty? %>
      <%= render FlatPack::EmptyState::Component.new(
        title: "No allowed destinations found.",
        description: "Try a different search term or review your move permissions.",
        icon: :search,
        class: "py-6"
      ) %>
    <% else %>
      <%= render FlatPack::List::Component.new do %>
        <% @destinations.each do |destination| %>
          <%= render FlatPack::List::Item.new(class: "items-center", hover: true) do %>
            <div class="flex w-full items-center justify-between gap-4">
              <div class="min-w-0 flex-1">
                <p class="font-medium text-(--surface-content-color)"><%= moveable_label_for(destination) %></p>
              </div>

              <%= form_with url: move_recording_path_for(recording_id: @recording.id), method: :post, local: true, class: "shrink-0" do %>
                <%= hidden_field_tag :destination_id, destination.id %>
                <%= hidden_field_tag :display, @display == :modal ? "modal" : "full_page" %>
                <%= hidden_field_tag :redirect_to, @redirect_to %>
                <%= render FlatPack::Button::Component.new(
                  text: "Move",
                  style: :default,
                  size: :sm,
                  type: "submit"
                ) %>
              <% end %>
            </div>
          <% end %>
        <% end %>
      <% end %>
    <% end %>
  </div>
</div>
