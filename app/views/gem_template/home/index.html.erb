<div class="max-w-4xl mx-auto px-6 py-12">
  <%= render FlatPack::PageTitle::Component.new(
    title: "GemTemplate Engine",
    subtitle: "Your Rails mountable engine is running successfully!",
    variant: :h1
  ) %>

  <%= render FlatPack::Grid::Component.new(cols: 1, gap: :lg, align: :stretch) do %>
    <%= render FlatPack::Card::Component.new(style: :elevated) do |card| %>
      <% card.header do %>
        <%= render FlatPack::SectionTitle::Component.new(title: "What's Working", class: "my-0") %>
      <% end %>

      <% card.body do %>
        <%= render FlatPack::List::Component.new(spacing: :dense) do %>
          <%= render FlatPack::List::Item.new do %>
            Rails Engine mounted and operational
          <% end %>
          <%= render FlatPack::List::Item.new do %>
            PostgreSQL with UUID primary keys
          <% end %>
          <%= render FlatPack::List::Item.new do %>
            TailwindCSS styling with automatic rebuild support
          <% end %>
          <%= render FlatPack::List::Item.new do %>
            Codespace environment automatically sets up the dummy app on build
          <% end %>
        <% end %>
      <% end %>
    <% end %>

    <%= render FlatPack::Card::Component.new(style: :elevated) do |card| %>
      <% card.header do %>
        <%= render FlatPack::SectionTitle::Component.new(title: "Next Steps: Rename Your Gem", class: "my-0") %>
      <% end %>

      <% card.body do %>
        <div class="space-y-4">
          <%= render FlatPack::Alert::Component.new(
            style: :info,
            title: "Current gem name",
            description: "This template is still named gem_template."
          ) %>

          <%= render FlatPack::List::Component.new(ordered: true, spacing: :dense) do %>
            <%= render FlatPack::List::Item.new do %>
              Run <code>bin/rename_gem your_gem_name</code> to rename the gem.
            <% end %>
            <%= render FlatPack::List::Item.new do %>
              Or ask AI to rename the gem using the rename script.
            <% end %>
            <%= render FlatPack::List::Item.new do %>
              See <code>docs/RENAMING.md</code> for the full rename workflow.
            <% end %>
            <%= render FlatPack::List::Item.new do %>
              Verify the rename by running tests and checking that the dummy app boots.
            <% end %>
          <% end %>
        </div>
      <% end %>
    <% end %>

    <%= render FlatPack::Card::Component.new(style: :elevated) do |card| %>
      <% card.header do %>
        <%= render FlatPack::SectionTitle::Component.new(title: "Tailwind CSS", class: "my-0") %>
      <% end %>

      <% card.body do %>
        <%= render FlatPack::List::Component.new(spacing: :dense) do %>
          <%= render FlatPack::List::Item.new do %>
            CSS is prebuilt when Codespaces starts.
          <% end %>
          <%= render FlatPack::List::Item.new do %>
            Tailwind auto-rebuilds if you start the server with <code>cd test/dummy && bin/dev</code>.
          <% end %>
          <%= render FlatPack::List::Item.new do %>
            In production, run <code>rails g gem_template:install</code> to add the gem view paths to the parent app Tailwind configuration.
          <% end %>
        <% end %>
      <% end %>
    <% end %>

    <%= render FlatPack::Card::Component.new(style: :elevated) do |card| %>
      <% card.header do %>
        <%= render FlatPack::SectionTitle::Component.new(title: "UI Components - FlatPack", class: "my-0") %>
      <% end %>

      <% card.body do %>
        <div class="space-y-4">
          <%= render FlatPack::Alert::Component.new(
            style: :info,
            title: "FlatPack is included",
            description: "This template ships with FlatPack, a Rails 8 ViewComponent library for forms, cards, buttons, tables, alerts, badges, and other app UI primitives."
          ) %>

          <%= render FlatPack::List::Component.new(divider: true, spacing: :dense) do %>
            <%= render FlatPack::List::Item.new do %>
              <strong>Customize your theme:</strong> FlatPack uses CSS variables for theming, so color and spacing changes apply across components automatically.
            <% end %>
            <%= render FlatPack::List::Item.new do %>
              <strong>Dark mode support:</strong> Components automatically adapt to system light and dark themes.
            <% end %>
            <%= render FlatPack::List::Item.new do %>
              <strong>Component library:</strong> The included set covers buttons, cards, forms, tables, alerts, badges, and more.
            <% end %>
          <% end %>
        </div>
      <% end %>

      <% card.footer do %>
        <%= render FlatPack::Button::Component.new(
          text: "View FlatPack Documentation",
          style: :primary,
          size: :sm,
          url: "https://github.com/bowerbird-app/flatpack",
          target: "_blank"
        ) %>
      <% end %>
    <% end %>

    <%= render FlatPack::Card::Component.new(style: :elevated) do |card| %>
      <% card.header do %>
        <%= render FlatPack::SectionTitle::Component.new(title: "Installing in a Rails App", class: "my-0") %>
      <% end %>

      <% card.body do %>
        <div class="space-y-4">
          <%= render FlatPack::Alert::Component.new(
            style: :info,
            title: "Install generator included",
            description: "This gem includes an install generator to wire everything up automatically."
          ) %>

          <%= render FlatPack::List::Component.new(ordered: true, spacing: :dense) do %>
            <%= render FlatPack::List::Item.new do %>
              Add the gem to your app's <code>Gemfile</code> and run <code>bundle install</code>.
            <% end %>
            <%= render FlatPack::List::Item.new do %>
              Run <code>rails generate gem_template:install</code>.
            <% end %>
          <% end %>

          <%= render FlatPack::List::Component.new(divider: true, spacing: :dense) do %>
            <%= render FlatPack::List::Item.new do %>
              Mount the engine at <code>/gem_template</code> in your routes.
            <% end %>
            <%= render FlatPack::List::Item.new do %>
              Configure Tailwind CSS to include the gem views when Tailwind is detected.
            <% end %>
            <%= render FlatPack::List::Item.new do %>
              Display post-installation instructions.
            <% end %>
          <% end %>
        </div>
      <% end %>
    <% end %>

    <%= render FlatPack::Card::Component.new(style: :elevated) do |card| %>
      <% card.header do %>
        <%= render FlatPack::SectionTitle::Component.new(title: "Template Features", class: "my-0") %>
      <% end %>

      <% card.body do %>
        <%= render FlatPack::List::Component.new(divider: true, spacing: :dense) do %>
          <%= render FlatPack::List::Item.new do %>
            <strong>Rename Script</strong> — Run <code>bin/rename_gem your_gem_name</code> to rename files, classes, modules, and references.
          <% end %>
          <%= render FlatPack::List::Item.new do %>
            <strong>Engine Hooks</strong> — Customize engine behavior from the host app with lifecycle, service, model, and controller hooks.
          <% end %>
          <%= render FlatPack::List::Item.new do %>
            <strong>Service Objects</strong> — Business logic is encapsulated in services with a Result-style success and failure flow.
          <% end %>
          <%= render FlatPack::List::Item.new do %>
            <strong>Install Generator</strong> — Run <code>rails g gem_template:install</code> to mount the engine, add configuration, and set up Tailwind.
          <% end %>
          <%= render FlatPack::List::Item.new do %>
            <strong>Migrations Generator</strong> — Run <code>rails g gem_template:migrations</code> to copy engine migrations into the host app.
          <% end %>
          <%= render FlatPack::List::Item.new do %>
            <strong>Configuration DSL</strong> — A simple API supports configuration through YAML and initializers.
          <% end %>
          <%= render FlatPack::List::Item.new do %>
            <strong>UUID Primary Keys</strong> — PostgreSQL UUIDs are available out of the box for models.
          <% end %>
        <% end %>
      <% end %>
    <% end %>
  <% end %>
</div>



