<div class="space-y-8" data-controller="move-modal" data-action="submit->move-modal#submit">
  <%= render FlatPack::PageTitle::Component.new(
    title: "Moveable demo",
    subtitle: "Browse folders first, then drill into the pages inside each folder.",
    variant: :h1
  ) %>

  <section class="space-y-6">
    <%= render FlatPack::SectionTitle::Component.new(
      title: "Folders",
      class: "my-0"
    ) %>

    <% if @folders.any? %>
      <%= render FlatPack::Grid::Component.new(cols: 3, gap: :lg, align: :stretch) do %>
        <% @folders.each do |folder_recording| %>
          <% recordable_type = folder_recording.recordable_type.sub(/^RecordingStudio/, "").underscore.humanize %>

          <%= render FlatPack::Card::Component.new(style: :elevated, padding: :none, class: "h-full") do |card| %>
            <% card.body do %>
              <div class="flex h-full flex-col gap-4">
                <div class="space-y-3 min-w-0">
                  <%= render(FlatPack::Link::Component.new(href: recording_studio_folder_path(folder_recording.recordable), class: "block text-base font-semibold")) do %>
                    <%= folder_recording.recordable.name %>
                  <% end %>

                  <%= render FlatPack::Badge::Component.new(
                    text: recordable_type,
                    style: :default,
                    size: :sm
                  ) %>
                </div>

                <div class="mt-auto pt-2">
                  <%= render FlatPack::Button::Dropdown::Component.new(
                    text: "Move",
                    style: :secondary,
                    size: :sm,
                    position: :bottom_right
                  ) do |dropdown| %>
                    <% dropdown.with_menu_item(
                         text: "Move",
                         href: recording_studio_moveable.move_recording_path(recording_id: folder_recording.id)
                       ) %>
                    <% dropdown.with_menu_item(
                         text: "Move modal",
                         href: recording_studio_moveable.move_recording_path(recording_id: folder_recording.id, display: "modal"),
                         data: { action: "click->move-modal#open" }
                       ) %>
                  <% end %>
                </div>
              </div>
            <% end %>
          <% end %>

        <% end %>
      <% end %>
    <% else %>
      <%= render FlatPack::EmptyState::Component.new(
        title: "No folders available",
        description: "The demo data has not been created for this workspace yet.",
        icon: :inbox
      ) %>
    <% end %>
  </section>

  <%= render FlatPack::Modal::Component.new(
    id: "move-recording-modal",
    size: :lg,
    body_height_mode: :fixed,
    body_height: "70vh",
    data: { move_modal_target: "modal" }
  ) do |modal| %>
    <% modal.body_content do %>
      <div data-move-modal-target="body">
        <%= render FlatPack::EmptyState::Component.new(
          title: "Choose a move action",
          description: "Use a move action on this page to load the move UI here.",
          icon: :inbox,
          class: "min-h-48 rounded-2xl border border-dashed border-(--surface-border-color) bg-(--surface-muted-background-color) px-6"
        ) %>
      </div>
    <% end %>
  <% end %>
</div>
