<div class="space-y-8">
  <%= render FlatPack::PageTitle::Component.new(
    title: "Moveable demo",
    subtitle: "Browse folders first, then drill into the pages inside each folder.",
    variant: :h1
  ) %>

  <section class="space-y-6">
    <%= render FlatPack::SectionTitle::Component.new(
      title: "Folders",
      class: "my-0"
    ) %>

    <% if @folders.any? %>
      <%= render FlatPack::Grid::Component.new(cols: 3, gap: :lg, align: :stretch) do %>
        <% @folders.each do |folder_recording| %>
          <% page_count = @page_counts_by_folder_id.fetch(folder_recording.id, 0) %>

          <%= render FlatPack::Card::Component.new(style: :elevated, padding: :none, class: "h-full") do |card| %>
            <% card.body do %>
              <div class="flex h-full flex-col gap-4">
                <div class="space-y-3 min-w-0">
                  <%= render(FlatPack::Link::Component.new(href: recording_studio_folder_path(folder_recording.recordable), class: "block text-base font-semibold")) do %>
                    <%= folder_recording.recordable.name %>
                  <% end %>

                  <%= render FlatPack::Badge::Component.new(
                    text: page_count == 1 ? "1 page" : "#{page_count} pages",
                    style: :default,
                    size: :sm
                  ) %>

                  <p class="text-sm text-(--surface-muted-content-color)">
                    Open this folder to view its pages.
                  </p>
                </div>

                <div class="mt-auto flex flex-wrap gap-2">
                  <%= render FlatPack::Button::Component.new(
                    text: "Open folder",
                    style: :default,
                    size: :sm,
                    url: recording_studio_folder_path(folder_recording.recordable),
                    class: "flex-1 justify-center"
                  ) %>

                  <%= render FlatPack::Button::Component.new(
                    text: "Move folder",
                    style: :secondary,
                    size: :sm,
                    url: recording_studio_moveable.move_recording_path(recording_id: folder_recording.id),
                    class: "flex-1 justify-center"
                  ) %>
                </div>
              </div>
            <% end %>
          <% end %>

        <% end %>
      <% end %>
    <% else %>
      <%= render FlatPack::EmptyState::Component.new(
        title: "No folders available",
        description: "The demo data has not been created for this workspace yet.",
        icon: :inbox
      ) %>
    <% end %>
  </section>
</div>
