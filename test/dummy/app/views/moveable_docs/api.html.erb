<div class="space-y-8">
  <%= render FlatPack::PageTitle::Component.new(
    title: "API action",
    subtitle: "Expose the Moveable action only for recordables and API surfaces that are ready to authorize it."
  ) %>

  <%= render FlatPack::Alert::Component.new(
    title: "Demo note",
    description: "This demo app currently ships without recording_studio_api because that gem still requires RecordingStudio 3. Moveable still registers the optional move action automatically once a host installs a RecordingStudio-4-compatible API release.",
    style: :warning
  ) %>

  <section class="space-y-4">
    <%= render FlatPack::SectionTitle::Component.new(
      title: "Enable the action",
      anchor_link: true,
      anchor_id: "enable-action",
      class: "my-0"
    ) %>

    <%= render FlatPack::CodeBlock::Component.new(
      title: "Recordable and public API setup",
      language: "ruby",
      code: <<~'CODE'
        # app/models/recording_studio_page.rb
        class RecordingStudioPage < ApplicationRecord
          recording_studio_recordable(
            label: "Page",
            root: false,
            allowed_parent_types: ["Workspace", "RecordingStudioFolder"]
          )

          include RecordingStudio::Capabilities::Moveable.enabled
        end

        # config/initializers/recording_studio_api.rb
        RecordingStudioApi.configure do |config|
          config.version "v1" do |api|
            api.use :moveable, "~> 1.0"
          end
        end

        RecordingStudioApi.register_recordable_type_api(
          "RecordingStudioPage",
          capability_actions: %i[move]
        )
      CODE
    ) %>

    <%= render FlatPack::Alert::Component.new(
      title: "Checklist",
      description: "The source recordable enables Moveable, its allowed parent types include the destination type, the active API version uses moveable 1.x, and the surface allowlists move. A missing step keeps the action unavailable.",
      style: :info
    ) %>
  </section>

  <section class="space-y-4">
    <%= render FlatPack::SectionTitle::Component.new(
      title: "Choose the API surface",
      anchor_link: true,
      anchor_id: "api-surface",
      class: "my-0"
    ) %>

    <p class="text-sm text-(--surface-muted-content-color)">
      Public and named APIs have separate action and recordable-type registries. Configuring one does not expose move on the other.
    </p>

    <%= render FlatPack::CodeBlock::Component.new(
      title: "Named API allowlist",
      language: "ruby",
      code: <<~'CODE'
        RecordingStudioApi.configure do |config|
          config.api :operations do |api|
            api.version "v1" do |version|
              version.use :moveable, "~> 1.0"
            end
          end
        end

        RecordingStudioApi.register_recordable_type_api(
          "RecordingStudioPage",
          api: :operations,
          capability_actions: %i[move]
        )
      CODE
    ) %>
  </section>

  <section class="space-y-4">
    <%= render FlatPack::SectionTitle::Component.new(
      title: "Move endpoint",
      anchor_link: true,
      anchor_id: "move-endpoint",
      class: "my-0"
    ) %>

    <%= render FlatPack::CodeBlock::Component.new(
      language: "http",
      code: <<~'CODE'
        POST /recording_studio_api/api/v1/recording_studio_pages/:id/actions/move
        Content-Type: application/json
        Authorization: ******

        { "parent_id": "<destination-recording-id>" }
      CODE
    ) %>

    <%= render FlatPack::Alert::Component.new(
      title: "Request requirements",
      description: "parent_id is preferred; destination_id and new_parent_id remain accepted for compatible clients. The API access grant must include both recordings with edit access. The destination must be an allowed parent and within the source root unless Moveable enables cross-root moves.",
      style: :info
    ) %>

    <%= render FlatPack::Alert::Component.new(
      title: "Results",
      description: "A successful move returns the reloaded recording. A destination outside the API grant is not found, policy denials return 403, and invalid structural moves return 422. Move metadata records the action, API client, and credential.",
      style: :info
    ) %>

  </section>

  <%= render FlatPack::Alert::Component.new(
    title: "Further reference",
    description: link_to(
      "RecordingStudioApi capability-backed action contract",
      "https://github.com/bowerbird-app/RecordingStudio_api#capability-backed-actions",
      target: "_blank",
      rel: "noopener noreferrer",
      class: "underline"
    ),
    style: :info
  ) %>
</div>
