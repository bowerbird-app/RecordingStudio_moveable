<div class="space-y-8">
  <%= render FlatPack::PageTitle::Component.new(
    title: "Setup",
    subtitle: "How to mark a recordable model as moveable in your app."
  ) %>

  <div class="space-y-4">
    <p class="text-sm text-[var(--surface-muted-content-color)]">
      Declare structural parent rules with RecordingStudio core, then add the moveable capability to any recordable model.
    </p>

    <%= render FlatPack::CodeBlock::Component.new(
      title: "Model setup",
      language: "ruby",
      code: <<~CODE
        class RecordingStudioPage < ApplicationRecord
          recording_studio_recordable \
            label: "Page",
            root: false,
            allowed_parent_types: ["Workspace", "RecordingStudioFolder"]

          include RecordingStudio::Capabilities::Moveable.to(allow_cross_root: true)
        end

        class RecordingStudioFolder < ApplicationRecord
          recording_studio_recordable \
            label: "Folder",
            root: false,
            allowed_parent_types: ["Workspace", "RecordingStudioFolder"]

          include RecordingStudio::Capabilities::Moveable.to(allow_cross_root: true)
        end
      CODE
    ) %>

    <p class="text-sm text-(--surface-muted-content-color)">
      Leave <code>allow_cross_root</code> off to keep the default same-workspace-only behavior. Destination parent types belong in core <code>recording_studio_recordable</code> declarations.
    </p>
  </div>
</div>