<div class="space-y-8">
  <%= render FlatPack::PageTitle::Component.new(
    title: "Moveable Docs",
    subtitle: "How destination types and move access checks are configured in this demo."
  ) %>

  <section class="space-y-4">
    <%= render FlatPack::SectionTitle::Component.new(
      title: "Where an item can move",
      anchor_link: true,
      anchor_id: "where-an-item-can-move",
      class: "my-0"
    ) %>

    <%= render FlatPack::Card::Component.new(style: :default) do |card| %>
      <% card.body do %>
        <div class="space-y-4">
          <%= render FlatPack::Alert::Component.new(
            style: :info,
            title: "Destination types come from the recordable model's moveable capability declaration.",
            description: "Include RecordingStudio::Capabilities::Moveable.to(...) on a recordable model and list the allowed parent recording types."
          ) %>

          <%= render FlatPack::CodeBlock::Component.new(
            snippets: [
              {
                label: "Ruby",
                language: "ruby",
                code: <<~CODE
                  class RecordingStudioPage < ApplicationRecord
                    include RecordingStudio::Capabilities::Moveable.to("Workspace", "RecordingStudioFolder")
                  end

                  class RecordingStudioFolder < ApplicationRecord
                    include RecordingStudio::Capabilities::Moveable.to("Workspace", "RecordingStudioFolder")
                  end
                CODE
              }
            ]
          ) %>

          <%= render FlatPack::List::Component.new(divider: true, spacing: :dense) do %>
            <%= render FlatPack::List::Item.new do %>
              In this demo, both pages and folders can move under a <strong>Workspace</strong> or another <strong>RecordingStudioFolder</strong>.
            <% end %>
            <%= render FlatPack::List::Item.new do %>
              Archive boxes are registered recordable types, but they are not listed in <code>Moveable.to(...)</code>, so they are excluded from the destination list and rejected by the move operation.
            <% end %>
          <% end %>
        </div>
      <% end %>
    <% end %>
  </section>

  <section class="space-y-4">
    <%= render FlatPack::SectionTitle::Component.new(
      title: "How access is checked",
      anchor_link: true,
      anchor_id: "how-access-is-checked",
      class: "my-0"
    ) %>

    <%= render FlatPack::Card::Component.new(style: :default) do |card| %>
      <% card.body do %>
        <div class="space-y-4">
          <%= render FlatPack::Alert::Component.new(
            style: :warning,
            title: "Authorization is evaluated for both the item being moved and the destination receiving it.",
            description: "By default, the addon uses built-in access checks, so the actor must have edit access on the source recording and also on the destination recording."
          ) %>

          <%= render FlatPack::CodeBlock::Component.new(
            snippets: [
              {
                label: "Ruby",
                language: "ruby",
                code: <<~CODE
                  RecordingStudio::Moveable::Authorization.destination_allowed?(
                    actor: actor,
                    source: source_recording,
                    destination: destination_recording
                  )
                CODE
              }
            ]
          ) %>

          <%= render FlatPack::List::Component.new(divider: true, spacing: :dense) do %>
            <%= render FlatPack::List::Item.new do %>
              The move UI only shows destinations that pass those checks, and the server validates them again when the move is submitted.
            <% end %>
            <%= render FlatPack::List::Item.new do %>
              If you disable built-in access, you can provide a custom authorization hook with <code>RecordingStudio::Moveable.configure</code>. That hook receives the actor, source, destination, impersonator, and metadata.
            <% end %>
          <% end %>
        </div>
      <% end %>
    <% end %>
  </section>

  <section class="space-y-4">
    <%= render FlatPack::SectionTitle::Component.new(
      title: "Other guardrails",
      anchor_link: true,
      anchor_id: "other-guardrails",
      class: "my-0"
    ) %>

    <%= render FlatPack::Card::Component.new(style: :default) do |card| %>
      <% card.body do %>
        <%= render FlatPack::List::Component.new(divider: true, spacing: :dense) do %>
          <%= render FlatPack::List::Item.new do %>
            <strong>Same root only:</strong> Moves stay inside the same root recording tree.
          <% end %>
          <%= render FlatPack::List::Item.new do %>
            <strong>No self or descendants:</strong> A recording cannot be moved under itself or any of its descendants.
          <% end %>
          <%= render FlatPack::List::Item.new do %>
            <strong>Server-side enforcement:</strong> The same checks are enforced in the model even if a client bypasses the UI.
          <% end %>
        <% end %>
      <% end %>
    <% end %>
  </section>
</div>