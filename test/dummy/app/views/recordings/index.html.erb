<div class="space-y-8">
  <%= render FlatPack::PageTitle::Component.new(
    title: "Recordings",
    subtitle: "Newest first so you can verify recording creation and movement at a glance."
  ) %>

  <% if @recordings.any? %>
    <%= render FlatPack::Table::Component.new(data: @recordings) do |table| %>
      <% table.column(title: "Item", html: ->(recording) {
           content_tag(:div, class: "min-w-0 space-y-1") do
             safe_join([
               content_tag(:p,
                 recording.recordable.try(:title) || recording.recordable.try(:name) || recording.recordable_type.demodulize,
                 class: "truncate font-medium text-(--surface-content-color)"
               ),
               content_tag(:p, recording.id, class: "truncate text-(--surface-muted-content-color)")
             ])
           end
         }) %>
      <% table.column(title: "Type", html: ->(recording) {
           content_tag(:div, recording.recordable_type.demodulize, class: "text-(--surface-content-color)")
         }) %>
      <% table.column(title: "Parent recording", html: ->(recording) {
           content_tag(:div, recording.parent_recording_id || "Root", class: "text-(--surface-muted-content-color)")
         }) %>
      <% table.column(title: "Created", html: ->(recording) {
           content_tag(:div, recording.created_at.strftime("%Y-%m-%d %H:%M:%S"), class: "text-(--surface-muted-content-color)")
         }) %>
    <% end %>
  <% else %>
    <%= render FlatPack::EmptyState::Component.new(
      title: "No recordings yet",
      description: "Create or move items to populate the recording timeline.",
      icon: :inbox
    ) %>
  <% end %>
</div>