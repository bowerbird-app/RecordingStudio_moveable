<div class="space-y-8" data-controller="move-modal" data-action="submit->move-modal#submit">
  <%= render FlatPack::Breadcrumb::Component.new(
    items: [{ text: "All folders", href: root_path, icon: "chevron-left" }],
    class: "mb-3"
  ) %>

  <%= render FlatPack::PageTitle::Component.new(
    title: @folder.name,
    subtitle: @children.one? ? "1 item in this folder" : "#{@children.count} items in this folder"
  ) %>

  <section>
    <% if @children.any? %>
      <%= render FlatPack::Grid::Component.new(cols: 3, gap: :lg, align: :stretch) do %>
        <% @children.each do |child_recording| %>
          <% recordable_type = child_recording.recordable_type.sub(/^RecordingStudio/, "").underscore.humanize %>
          <%= render FlatPack::Card::Component.new(style: :elevated, class: "h-full") do |card| %>
            <% card.body do %>
              <div class="flex h-full flex-col gap-4">
                <div class="min-w-0 space-y-3">
                  <% item_href = if child_recording.recordable_type == "RecordingStudioFolder"
                                   recording_studio_folder_path(child_recording.recordable)
                                 else
                                   recording_studio_page_path(child_recording.recordable)
                                 end %>
                  <% item_title = if child_recording.recordable_type == "RecordingStudioFolder"
                                    child_recording.recordable.name
                                  else
                                    child_recording.recordable.title
                                  end %>
                  <% item_description = if child_recording.recordable_type == "RecordingStudioFolder"
                                          "Open this folder to browse its nested folders and pages."
                                        else
                                          child_recording.recordable.body.presence || "No preview text available for this page yet."
                                        end %>

                  <%= render(FlatPack::Link::Component.new(href: item_href, class: "block text-base font-semibold text-(--surface-content-color)")) do %>
                    <%= item_title %>
                  <% end %>

                  <%= render FlatPack::Badge::Component.new(
                    text: recordable_type,
                    style: :default,
                    size: :sm
                  ) %>

                  <p class="text-sm leading-6 text-(--surface-muted-content-color)">
                    <%= item_description %>
                  </p>
                </div>

                <div class="mt-auto pt-2">
                  <%= render FlatPack::Button::Dropdown::Component.new(
                    text: "Move",
                    style: :secondary,
                    size: :sm,
                    position: :bottom_right
                  ) do |dropdown| %>
                    <% dropdown.with_menu_item(
                         text: "Move",
                         href: recording_studio_moveable.move_recording_path(recording_id: child_recording.id)
                       ) %>
                    <% dropdown.with_menu_item(
                         text: "Move modal",
                         href: recording_studio_moveable.move_recording_path(recording_id: child_recording.id, display: "modal"),
                         data: { action: "click->move-modal#open" }
                       ) %>
                  <% end %>
                </div>
              </div>
            <% end %>
          <% end %>
        <% end %>
      <% end %>
    <% else %>
      <%= render FlatPack::EmptyState::Component.new(
        title: "No items yet",
        description: "Create or move a folder or page into this folder to populate it.",
        icon: :inbox
      ) %>
    <% end %>
  </section>

  <%= render FlatPack::Modal::Component.new(
    id: "move-recording-modal",
    size: :lg,
    body_height_mode: :fixed,
    body_height: "70vh",
    data: { move_modal_target: "modal" }
  ) do |modal| %>
    <% modal.body_content do %>
      <div data-move-modal-target="body">
        <%= render FlatPack::EmptyState::Component.new(
          title: "Choose a move action",
          description: "Use a move action on this page to load the move UI here.",
          icon: :inbox,
          class: "min-h-48 rounded-2xl border border-dashed border-(--surface-border-color) bg-(--surface-muted-background-color) px-6"
        ) %>
      </div>
    <% end %>
  <% end %>
</div>
