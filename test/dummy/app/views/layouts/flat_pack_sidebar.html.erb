<!DOCTYPE html>
<html class="light h-full overflow-hidden overscroll-none" data-theme="rounded">
  <head>
    <title><%= content_for(:title) || "Dummy" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Dummy">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "flat_pack/variables", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "flat_pack/application", "data-turbo-track": "reload" %>
    <% if recording_studio_moveable_asset_available?("tailwind.css") %>
      <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <% end %>
    <%= recording_studio_moveable_meta_tags %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="m-0 h-full overflow-hidden overscroll-none bg-(--surface-page-background-color) text-(--surface-content-color)" data-controller="dark-mode">
    <%= render "layouts/icon_sprite" %>

    <% sidebar_side = params[:side].in?(%w[left right]) ? params[:side].to_sym : :left %>
    <%= render FlatPack::SidebarLayout::Component.new(side: sidebar_side, storage_key: "flatpack-dummy-shell") do |layout| %>
      <% layout.sidebar do %>
        <%= render "layouts/flat_pack/sidebar", sidebar_side: sidebar_side %>
      <% end %>

      <% layout.top_nav do %>
        <%= render "layouts/flat_pack/top_nav" %>
      <% end %>

      <% layout.main do %>
        <main class="p-4 sm:p-8 bg-(--surface-page-background-color) text-(--surface-content-color)">
          <div class="max-w-4xl mx-auto pb-24">
            <% if notice.present? %>
              <%= render FlatPack::Alert::Component.new(description: notice, style: :success, dismissible: true, class: "mb-4") %>
            <% end %>

            <% if alert.present? %>
              <%= render FlatPack::Alert::Component.new(description: alert, style: :danger, dismissible: true, class: "mb-4") %>
            <% end %>

            <%= yield %>
          </div>
        </main>
      <% end %>
    <% end %>

    <%= recording_studio_moveable_modal_template %>
  </body>
</html>
