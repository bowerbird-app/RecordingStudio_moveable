<%= render FlatPack::Sidebar::Component.new(side: sidebar_side) do |sidebar| %>
  <% sidebar.header do %>
    <%= render FlatPack::Sidebar::Header::Component.new(
      brand_abbr: "RS",
      title: "Moveable",
      subtitle: "Moveable Demo"
    ) %>
  <% end %>

  <% sidebar.items do %>
    <nav class="py-4 space-y-1" aria-label="Main navigation">
      <%= render FlatPack::Sidebar::Item::Component.new(
        label: "Home",
        href: "/",
        icon: "home",
        active: current_page?("/")
      ) %>

      <%= render FlatPack::Sidebar::Item::Component.new(
        label: "Events",
        href: events_path,
        icon: "calendar-days",
        active: current_page?(events_path)
      ) %>

      <%= render FlatPack::Sidebar::Item::Component.new(
        label: "Moveable Docs",
        href: moveable_docs_path,
        icon: "question",
        active: current_page?(moveable_docs_path)
      ) %>

      <%= render FlatPack::Sidebar::Item::Component.new(
        label: "Destinations",
        href: access_docs_path,
        icon: "lock-closed",
        active: current_page?(access_docs_path)
      ) %>

      <%= render FlatPack::Sidebar::Item::Component.new(
        label: "Setup",
        href: setup_docs_path,
        icon: "wrench-screwdriver",
        active: current_page?(setup_docs_path)
      ) %>

      <%= render FlatPack::Sidebar::Item::Component.new(
        label: "Methods",
        href: methods_docs_path,
        icon: "code-bracket-square",
        active: current_page?(methods_docs_path)
      ) %>

      <%= render FlatPack::Sidebar::Item::Component.new(
        label: "Redirects",
        href: redirects_docs_path,
        icon: "arrow-right-on-rectangle",
        active: current_page?(redirects_docs_path)
      ) %>

    </nav>
  <% end %>

  <% sidebar.footer do %>
    <%= render FlatPack::Sidebar::Footer::Component.new(class: "text-sm text-[var(--surface-muted-content-color)]") do %>
      <%= render FlatPack::Sidebar::Item::Component.new(
        label: "Sign out",
        href: destroy_user_session_path,
        icon: "arrow-right-on-rectangle",
        class: "mx-0",
        data: { turbo_method: :delete }
      ) %>
    <% end %>
  <% end %>
<% end %>
