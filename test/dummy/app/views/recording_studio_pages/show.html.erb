<%= render FlatPack::PageTitle::Component.new(
  title: @page.title,
  subtitle: "Page demo"
) %>

<%= render FlatPack::ButtonGroup::Component.new(class: "mt-4") do |group| %>
  <% group.button(
       FlatPack::Button::Component.new(
         text: "Move (full page)",
         style: :primary,
         size: :sm,
         url: recording_studio_moveable.move_recording_path(recording_id: @recording.id)
       )
     ) %>
  <% group.button(
       FlatPack::Button::Component.new(
         text: "Move (modal mode)",
         style: :ghost,
         size: :sm,
         url: recording_studio_moveable.move_recording_path(recording_id: @recording.id),
         data: { recording_studio_moveable_modal: true }
       )
     ) %>
<% end %>
