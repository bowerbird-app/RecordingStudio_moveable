<div class="space-y-8">
  <%= render FlatPack::PageTitle::Component.new(
    title: "Folder Recordables",
    subtitle: "Folder records in newest-first order with their linked recording ids."
  ) %>

  <% if @folder_recordables.any? %>
    <%= render FlatPack::Table::Component.new(data: @folder_recordables) do |table| %>
      <% table.column(title: "Name", html: ->(folder) {
           content_tag(:div, class: "min-w-0 space-y-1") do
             safe_join([
               content_tag(:p, folder.name, class: "truncate font-medium text-(--surface-content-color)"),
               content_tag(:p, folder.id, class: "truncate text-(--surface-muted-content-color)")
             ])
           end
         }) %>
      <% table.column(title: "Recording id", html: ->(folder) {
           recording = @recordings_by_folder_id[folder.id]
           content_tag(:div, recording&.id || "Missing", class: "truncate text-(--surface-muted-content-color)")
         }) %>
      <% table.column(title: "Created", html: ->(folder) {
           content_tag(:div, folder.created_at.strftime("%Y-%m-%d %H:%M:%S"), class: "text-(--surface-muted-content-color)")
         }) %>
      <% table.column(title: "Open", html: ->(folder) {
           render FlatPack::Button::Component.new(
             text: "Open",
             style: :ghost,
             size: :sm,
             url: recording_studio_folder_path(folder)
           )
         }) %>
    <% end %>
  <% else %>
    <%= render FlatPack::EmptyState::Component.new(
      title: "No folder recordables yet",
      description: "Bootstrap or create folders to populate this list.",
      icon: :inbox
    ) %>
  <% end %>
</div>