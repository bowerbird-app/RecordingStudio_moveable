<div class="space-y-8">
  <%= render FlatPack::PageTitle::Component.new(
    title: "Pages Recordables",
    subtitle: "Page records in newest-first order so moved items are easy to verify."
  ) %>

  <% if @page_recordables.any? %>
    <%= render FlatPack::Table::Component.new(data: @page_recordables) do |table| %>
      <% table.column(title: "Title", html: ->(page) {
           content_tag(:div, class: "min-w-0 space-y-1") do
             safe_join([
               content_tag(:p, page.title, class: "truncate font-medium text-(--surface-content-color)"),
               content_tag(:p, page.id, class: "truncate text-(--surface-muted-content-color)")
             ])
           end
         }) %>
      <% table.column(title: "Body preview", html: ->(page) {
           content_tag(:div, truncate(page.body.presence || "No body content", length: 120), class: "text-(--surface-muted-content-color)")
         }) %>
      <% table.column(title: "Recording id", html: ->(page) {
           recording = @recordings_by_page_id[page.id]
           content_tag(:div, recording&.id || "Missing", class: "truncate text-(--surface-muted-content-color)")
         }) %>
      <% table.column(title: "Created", html: ->(page) {
           content_tag(:div, page.created_at.strftime("%Y-%m-%d %H:%M:%S"), class: "text-(--surface-muted-content-color)")
         }) %>
    <% end %>
  <% else %>
    <%= render FlatPack::EmptyState::Component.new(
      title: "No page recordables yet",
      description: "Bootstrap or create pages to populate this list.",
      icon: :inbox
    ) %>
  <% end %>
</div>