<div class="space-y-8">
  <%= render FlatPack::PageTitle::Component.new(
    title: "Pages Recordables",
    subtitle: "Page records in newest-first order so moved items are easy to verify."
  ) %>

  <% if @page_recordables.any? %>
    <div class="overflow-hidden rounded-2xl border border-(--surface-border-color) bg-(--surface-background-color)">
      <div class="grid grid-cols-[minmax(0,2fr)_minmax(0,2.5fr)_minmax(0,1.25fr)_minmax(0,1fr)] gap-4 border-b border-(--surface-border-color) px-4 py-3 text-xs font-semibold uppercase tracking-wide text-(--surface-muted-content-color)">
        <div>Title</div>
        <div>Body preview</div>
        <div>Recording id</div>
        <div>Created</div>
      </div>

      <div class="divide-y divide-(--surface-border-color)">
        <% @page_recordables.each do |page| %>
          <% recording = @recordings_by_page_id[page.id] %>
          <div class="grid grid-cols-[minmax(0,2fr)_minmax(0,2.5fr)_minmax(0,1.25fr)_minmax(0,1fr)] gap-4 px-4 py-4 text-sm">
            <div class="min-w-0 space-y-1">
              <p class="truncate font-medium text-(--surface-content-color)"><%= page.title %></p>
              <p class="truncate text-(--surface-muted-content-color)"><%= page.id %></p>
            </div>

            <div class="text-(--surface-muted-content-color)"><%= truncate(page.body.presence || "No body content", length: 120) %></div>
            <div class="truncate text-(--surface-muted-content-color)"><%= recording&.id || "Missing" %></div>
            <div class="text-(--surface-muted-content-color)"><%= page.created_at.strftime("%Y-%m-%d %H:%M:%S") %></div>
          </div>
        <% end %>
      </div>
    </div>
  <% else %>
    <%= render FlatPack::EmptyState::Component.new(
      title: "No page recordables yet",
      description: "Bootstrap or create pages to populate this list.",
      icon: :inbox
    ) %>
  <% end %>
</div>