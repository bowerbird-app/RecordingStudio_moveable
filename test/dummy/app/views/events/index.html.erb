<div class="space-y-8">
  <%= render FlatPack::PageTitle::Component.new(
    title: "Events",
    subtitle: "Newest events first so move activity is visible immediately."
  ) %>

  <% if @events.any? %>
    <%= render FlatPack::Table::Component.new(data: @events) do |table| %>
      <% table.column(title: "Action", html: ->(event) {
           content_tag(:div, event.action, class: "font-medium text-(--surface-content-color)")
         }) %>
      <% table.column(title: "Recordable", html: ->(event) {
           content_tag(:div, class: "min-w-0 text-(--surface-muted-content-color)") do
             safe_join([
               content_tag(:p, event.recordable_type.demodulize, class: "truncate"),
               content_tag(:p, event.recordable_id, class: "truncate")
             ])
           end
         }) %>
      <% table.column(title: "Occurred", html: ->(event) {
           content_tag(:div, event.occurred_at.strftime("%Y-%m-%d %H:%M:%S"), class: "text-(--surface-muted-content-color)")
         }) %>
      <% table.column(title: "Metadata", html: ->(event) {
           content_tag(:div, event.metadata.presence&.to_json || "{}", class: "text-(--surface-muted-content-color)")
         }) %>
    <% end %>
  <% else %>
    <%= render FlatPack::EmptyState::Component.new(
      title: "No events yet",
      description: "Move an item to create an event record for inspection here.",
      icon: :inbox
    ) %>
  <% end %>
</div>